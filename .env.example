POLICY_MODEL=gpt-oss-20b
POLICY_PROTOCOL=vllm_tokens
POLICY_BASE_URL=http://127.0.0.1:8000/v1
JUDGE_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_MODEL_API_KEY=EMPTY
LOCAL_HYBRID_QDRANT_URL=http://127.0.0.1:6333
LOCAL_HYBRID_EMBEDDING_URL=http://127.0.0.1:8012/v1
LOCAL_HYBRID_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
VLLM_RERANKER_URL=http://127.0.0.1:8011
# Reference serving layout
TENSOR_PARALLEL_SIZE=8
POLICY_GPU_MEMORY=0.55
EMBEDDING_GPU_MEMORY=0.22
RERANKER_GPU_MEMORY=0.18
PARALLEL=4
MAX_TURNS=40
MAX_TOKENS=2048
# S_max: search operations between successful curation steps.
INTENT_SEARCHES_PER_STAGE=5
SUMMARY_MIN_RETRIEVAL_CALLS=5
# Supply HF_TOKEN via your shell or `hf auth login` for restricted repositories.
# DATA_ROOT=/absolute/path/to/data
# POLICY_MODEL_PATH=/absolute/path/to/checkpoint
# EMBEDDING_MODEL=/absolute/path/to/embedding/checkpoint
# RERANKER_MODEL=/absolute/path/to/reranker/checkpoint

QDRANT_BIN="$ROOT/data/qdrant_server/bin/qdrant"
QDRANT_CONFIG="$ROOT/data/qdrant_server/config.yaml"
MAX_FORMAT_RETRIES=3
MAX_POLICY_CURATE_ATTEMPTS=3
MAX_INTENT_REQUIRED_ATTEMPTS=3
MAX_CHECKPOINT_CURATE_ATTEMPTS=2
