# Optional machine-specific overrides; copy to runtime_paths.env (gitignored).
# All values below are examples. Unset paths are resolved from the checkout.
# PYTHON_BIN=/absolute/path/to/.venv/bin/python
# VLLM_BIN=/absolute/path/to/.venv-serve/bin/vllm
# DATA_ROOT=/absolute/path/to/data
# POLICY_MODEL_PATH=/absolute/path/to/Qwen3.5-27B
# EMBEDDING_MODEL=/absolute/path/to/Qwen3-Embedding-8B
# RERANKER_MODEL=/absolute/path/to/Qwen3-Reranker-8B
